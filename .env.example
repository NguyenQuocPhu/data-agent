# Company-hosted OpenAI-compatible gateway. Copy to .env and replace the key locally.
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://proxy.onebot.meobeo.ai/v1
OPENAI_MODEL_ID=hosted_vllm/Qwen/Qwen3.5-35B-A3B-FP8
OPENAI_EXTRA_BODY={"cache":{"no-cache":true},"chat_template_kwargs":{"enable_thinking":false},"timeout":240}
DATA_AGENT_RUNTIME=rlm
CLEAR_DATASETS_ON_START=0

# Legacy alternatives.
QWEN_API_KEY=
GROQ_API_KEY=

# H2O ML Studio. Leave H2O_URL empty to start one local Java cluster inside backend.
H2O_URL=
H2O_MAX_MEM_SIZE=4G
H2O_NTHREADS=-1
H2O_MAX_CONCURRENT_EXPERIMENTS=1
